<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            `windowSoftInputMode="adjustResize"` is load-bearing for writing a note.

            Android's default for this attribute is `adjustUnspecified`, which lets
            the system choose — and on a WebView it often chooses to pan or overlay
            instead of resizing, which is how the soft keyboard ends up covering the
            field being typed into and how a fixed bottom bar ends up drawn over the
            keys. `adjustResize` states the intent instead: the window shrinks to the
            space above the keyboard, so the layout the web layer measures is the
            layout the user can actually see, `position: fixed` elements land above
            the keyboard rather than behind it, and no code has to guess a keyboard
            height.

            It is paired with hiding the tab bar while an editor is open
            (`stores/editor-store.ts`): resizing keeps the *field* visible, and the
            bar is removed so there is nothing left to overlap.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                The share target.

                `text/*` rather than a list of named applications, and rather
                than `text/plain` alone: any app that shares text can share into
                Stash, including the ones that send text/html alongside it. There
                is no source-specific handling anywhere in the app — the shared
                text is parsed the same way whoever sent it.

                `singleTask` is load-bearing. It makes Android route a share
                into the running instance through `onNewIntent` instead of
                building a second copy of the app, which is what gives the
                closed / backgrounded / already-open cases one code path.
                Sharing also brings Stash to the front, so the sheet is on screen
                by the time the finger lifts.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <!--
                Several links at once, which browsers and YouTube offer for a
                multi-selection. The plugin reads the first text it finds; the
                link parser already understands text containing more than one
                URL, so the extras surface as "also save these".
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
