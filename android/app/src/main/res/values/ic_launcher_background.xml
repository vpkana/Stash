<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive icon's background layer.

    Flat, one colour, the same in light and dark: the app icon is the one surface
    that does not follow the theme, because a launcher shows it next to every other
    app rather than inside Stash. `#1B1A4D` is `brand_ink` — the tile the mark was
    drawn on, and the reason the icon and the interface read as one thing.
-->
<resources>
    <color name="ic_launcher_background">#1B1A4D</color>
</resources>
