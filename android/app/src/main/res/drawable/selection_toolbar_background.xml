<?xml version="1.0" encoding="utf-8"?>
<!--
    The card behind Android's own Cut / Copy / Paste menu.

    The menu is drawn by the system, not by Stash, but its surface is whatever
    this app's theme says it is — and the theme's default was a nine-patch tinted
    for a palette the app does not use. `colorBackgroundFloating` is the palette's
    own floating-surface colour, so the card follows the app's light/dark mode
    (the activity's night mode is kept in step by `ThemeModePlugin`) instead of
    being a grey rectangle from somewhere else.

    The radius is the one every sheet and popover in the interface uses, so the
    menu reads as part of the app rather than as a system control parked on top
    of it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?android:attr/colorBackgroundFloating" />
    <corners android:radius="12dp" />
</shape>
