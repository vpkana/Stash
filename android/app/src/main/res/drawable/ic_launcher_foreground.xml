<?xml version="1.0" encoding="utf-8"?>
<!--
    The Android adaptive-icon foreground: the Stash mark, as a vector.

    A vector rather than a bitmap because the launcher draws this at sizes from
    48dp to 192dp and a PNG only looks right at the density it was rendered for.
    The geometry is the same path as `public/icons/foreground.svg`, scaled into
    the 108-unit adaptive canvas.

    The scale is 0.22, and that number is the fix for an icon that was drawn too
    large. Android masks an adaptive icon to whatever shape the launcher uses, and
    the region guaranteed to survive every one of those shapes is a 66-unit circle
    centred on the 108-unit canvas. At the old `0.27637` the ribbon's box was
    40.5 by 63.0 units — a half-diagonal of 41.3 against a safe radius of 33 — so
    its bottom tips fell outside the circle and a round mask sliced them off. At
    `0.22` the box is 40.5 by 50.2 units, half-diagonal 32.3, comfortably inside,
    and the mark occupies 46% of the canvas, which is the proportion Google's own
    adaptive icons use.

    The colour is `brand_cream`, the same value as the `brand.cream` custom
    property in `src/app/globals.css`; the tile behind it is `brand_ink`. The icon
    is the one surface that is the same in light and dark mode, so neither value
    changes between the day and night resource sets.

    Note for editors: this is an XML comment, so a doubled hyphen cannot appear
    inside it. Writing a CSS custom property out in full here will not compile.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="54"
        android:translateY="53.6"
        android:scaleX="0.22"
        android:scaleY="0.22">
        <group
            android:translateX="-256"
            android:translateY="-254">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M 204 140 H 308 Q 348 140 348 180 V 352 Q 348 368 336 368 L 268 322 Q 256 317 244 322 L 176 368 Q 164 368 164 352 V 180 Q 164 140 204 140 Z" />
        </group>
    </group>
</vector>
